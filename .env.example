# Copy to .env and fill in real values. Never commit .env.

# HTTP
APP_HTTP_ADDR=:8080

# PostgreSQL
APP_POSTGRES_DSN=postgres://craftshelf:craftshelf_dev_pwd@localhost:5432/craftshelf?sslmode=disable

# Redis
APP_REDIS_ADDR=localhost:6379

# JWT: required, >= 32 bytes, no whitespace/control chars, must not be a default placeholder
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
APP_JWT_TTL=24h
APP_BCRYPT_COST=12

# S3 / SeaweedFS
APP_S3_ENDPOINT=http://localhost:8333
APP_S3_REGION=us-east-1
APP_S3_ACCESS_KEY=craftshelf
APP_S3_SECRET_KEY=craftshelf_dev_pwd
APP_S3_BUCKET_WORKS=craftshelf-works
APP_S3_BUCKET_AVATARS=craftshelf-avatars
APP_S3_USE_PATH_STYLE=true
